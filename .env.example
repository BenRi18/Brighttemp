# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# The public address of this site, used to build every link sent by email.
# Required in production: without it the app refuses to email a link rather
# than guessing from the Host header, which behind a proxy is an internal IP.
#
# Set SITE_URL, not NEXT_PUBLIC_SITE_URL, on the live host. Anything prefixed
# NEXT_PUBLIC_ is baked into the build as a literal, so changing it in the
# hosting panel after a deploy has no effect until the app is rebuilt.
# SITE_URL is read on every request, so a restart is enough.
SITE_URL=https://brighttempbookinghub.co.uk

# Protects /api/cron/compliance.
CRON_SECRET=

# Preview mode: show every page with built-in sample data — no database or sign-in.
# Development only; ignored by production builds.
MOCK_DATA=false

# Demo preview (/dev). On automatically in development; set to true only on a staging site.
ENABLE_DEMO_PREVIEW=false
DEMO_PASSWORD=Brighttemp-demo-2026
DEMO_EMAIL_DOMAIN=example.com
